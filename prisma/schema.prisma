datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

model Activity {
  id        String   @id @default(cuid())
  code      String
  name      String
  client    String?
  stage     String
  priority  String   @default("Média")
  createdAt DateTime @default(now())
}
